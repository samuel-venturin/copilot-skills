{
  "python": {
    "writeBytecode": false
  },
  "defaults": {
    "base": "develop",
    "bump": "auto",
    "createTag": false,
    "createOrUpdatePr": true,
    "draft": false,
    "prBodyStyle": "refined"
  },
  "quality": {
    "requirePassingTests": true,
    "defaultProfile": "node",
    "profiles": {
      "node": {
        "detect": ["package.json"],
        "commands": [
          "pnpm coverage",
          "pnpm run typecheck",
          "pnpm run lint"
        ],
        "blockingCommands": ["pnpm coverage"]
      },
      "dotnet": {
        "detect": ["*.sln"],
        "commands": [
          "dotnet build -c Release",
          "dotnet test -c Release"
        ],
        "blockingCommands": [
          "dotnet build -c Release",
          "dotnet test -c Release"
        ]
      }
    },
    "blockingCommands": [
      "pnpm coverage"
    ],
    "commands": [
      "pnpm coverage",
      "pnpm run typecheck",
      "pnpm run lint"
    ]
  }
}
