{
  "_comment": "base_dir/wsl_home are auto-discovered at runtime (see discover_base_dir/discover_wsl_home in local_stack.py) and cached in resolved_env.json. Set an explicit value here, or the env vars LOCAL_STACK_BASE_DIR / LOCAL_STACK_WSL_HOME, to override discovery.",
  "base_dir": null,
  "base_dir_search_roots": [
    "~/Documents/GitHub",
    "~/GitHub",
    "~/source/repos",
    "~/repos",
    "~/dev",
    "~/Projects",
    "~/projects"
  ],
  "wsl_home": null,
  "wsl_compose_dir_relative": "projects/customers-manager-service/deployments/fullProject",
  "services": {
    "infra": {
      "type": "docker-compose-wsl",
      "compose_dir_relative": "projects/customers-manager-service/deployments/fullProject",
      "services_filter": "mongo",
      "health_url": null,
      "port": 27017,
      "optional": true,
      "depends_on": []
    },
    "domain": {
      "type": "dotnet",
      "project": "customers-domain-service\\src\\CustomersDomainService\\CustomersDomainService.csproj",
      "launch_json": "customers-domain-service\\.vscode\\launch.json",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Local",
        "ASPNETCORE_URLS": "http://+:5000"
      },
      "health_url": null,
      "port": 5000,
      "optional": false,
      "depends_on": ["infra"]
    },
    "tasks": {
      "type": "dotnet",
      "project": "tasks-manager-service\\src\\TasksManagerService\\TasksManagerService.csproj",
      "launch_json": "tasks-manager-service\\.vscode\\launch.json",
      "health_url": null,
      "port": 6000,
      "optional": true,
      "depends_on": ["infra"]
    },
    "bff": {
      "type": "dotnet",
      "project": "customers-manager-service\\src\\CustomersManagerService\\CustomersManagerService.csproj",
      "launch_json": "customers-manager-service\\.vscode\\launch.json",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Local",
        "ASPNETCORE_URLS": "http://+:7000"
      },
      "health_url": null,
      "port": 7000,
      "optional": false,
      "depends_on": ["domain"]
    },
    "frontend": {
      "type": "pnpm",
      "project": "customers-manager-ui",
      "command": "pnpm dev",
      "health_url": null,
      "port": 3000,
      "optional": false,
      "depends_on": ["bff"]
    }
  },
  "start_order": ["infra", "domain", "tasks", "bff", "frontend"]
}
